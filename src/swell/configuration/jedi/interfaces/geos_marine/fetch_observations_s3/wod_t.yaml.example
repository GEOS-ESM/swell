# Example: fetch World Ocean Database temperature observations directly from the
# public NOAA reanalysis S3 bucket (noaa-reanalyses-pds) instead of from R2D2.
#
# HOW TO ACTIVATE
# ---------------
# 1. Set the fetch_obs_from_public_s3: True
#    (GetObservations question; default False -> everything stays on R2D2).
# 2. Copy/rename this file to `wod_t.yaml` in your experiment's
#      configuration/jedi/interfaces/geos_marine/fetch_observations_s3/
#    The filename (minus .yaml) MUST match the observation operator name in your
#    experiment `observations` list. There must therefore be a matching obs
#    operator (obs space / obsdatain / obsfile) named `wod_t` for JEDI to consume
#    the downloaded file.
#
# The file is pulled anonymously (no AWS credentials) into the cycle directory;
# nothing is stored in any R2D2 datastore. WOD ioda files are already IODA
# NetCDF, so no BUFR->IODA conversion is needed.

s3_bucket: noaa-reanalyses-pds

# Full object key with date placeholders (YYYY MM DD HH; JJJ = day of year).
# Exact-key mode: one GET, no listing, so over-pulling is impossible.
s3_key_template: observations/reanalysis/insitu/wod/ioda/wod_t_YYYYMMDDHH.ioda.nc

# WOD ioda samples are organized per cycle hour. If your DA window differs from
# the default sub-window grid (T03/T09/T15/T21), override it here so the
# requested times line up with the keys that actually exist in the bucket.
# obs_timesteps: ['T00', 'T06', 'T12', 'T18']
# obs_window_length: PT6H
