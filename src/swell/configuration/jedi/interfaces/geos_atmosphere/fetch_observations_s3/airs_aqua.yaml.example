# Example: fetch airs_aqua observations directly from the public NOAA reanalysis
# S3 bucket (noaa-reanalyses-pds) instead of from R2D2.
#
# To activate, copy/rename this file to `airs_aqua.yaml` in your experiment's
#   configuration/jedi/interfaces/geos_atmosphere/fetch_observations_s3/
# directory. The filename must match the observation operator name in the
# experiment `observations` list.
#
# The file is pulled anonymously (no AWS credentials) into the cycle directory;
# nothing is stored in any R2D2 datastore.

s3_bucket: noaa-reanalyses-pds

# Full object key with date placeholders. Exact-key mode (single GET, no listing).
s3_key_template: observations/reanalysis/airs/nasa/aqua/YYYY/MM/bufr/airs_disc_final.YYYYMMDD.tHHz.bufr

# These BUFR files are 6-hourly synoptic (t00/06/12/18z). Override the default
# sub-window grid so the requested times match the files that exist.
obs_timesteps: ['T00', 'T06', 'T12', 'T18']
obs_window_length: PT6H

# NOTE: AIRS files here are raw BUFR. JEDI consumes IODA, so a BUFR->IODA
# conversion step is still required before these can be assimilated.
