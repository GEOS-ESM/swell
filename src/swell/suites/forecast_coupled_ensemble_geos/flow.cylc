# --------------------------------------------------------------------------------------------------

# Cylc suite for coupled GEOSgcm ensemble forecast

# --------------------------------------------------------------------------------------------------

{% set members = range(1, ensemble_num_members + 1) %}

[scheduler]
    UTC mode = True
    allow implicit tasks = False

{{scheduling['stall_timeout']}}

# --------------------------------------------------------------------------------------------------

[scheduling]

    initial cycle point = {{start_cycle_point}}
    final cycle point = {{final_cycle_point}}

    [[graph]]
        R1 = """
            # Triggers for non cycle time dependent tasks
            # -------------------------------------------
            # Clone Geos source code
            CloneGeos

            # Build Geos source code by linking
            CloneGeos => BuildGeosByLinking?

            # If not able to link to build create the build
            BuildGeosByLinking:fail? => BuildGeos

            # Need first set of restarts to run ensemble members
            GetCoupledGeosRestart => PrepCoupledEnsembleGeosRunDir

            # Build must be complete before running
            BuildGeosByLinking? | BuildGeos => PrepCoupledEnsembleGeosRunDir
        """

        {% for cycle_time in cycle_times %}
        {{cycle_time}} = """

            # Prep ensemble dirs then launch all members concurrently
            PrepCoupledEnsembleGeosRunDir => {% for m in members %}RunGeosEns_{{"%03d" | format(m)}}{% if not loop.last %} & {% endif %}{% endfor %}

            # Wait for previous cycle's restart move before prepping
            MoveEnsembleForecastRestarts[-PT6H] => PrepCoupledEnsembleGeosRunDir

            # All members must finish before moving restarts
            {% for m in members %}RunGeosEns_{{"%03d" | format(m)}}{% if not loop.last %} & {% endif %}{% endfor %} => MoveEnsembleForecastRestarts

        """
        {% endfor %}

# --------------------------------------------------------------------------------------------------

[runtime]

    # Task defaults
    # -------------
    [[root]]
        pre-script = "source $CYLC_SUITE_DEF_PATH/modules"

        [[[environment]]]
            datetime = $CYLC_TASK_CYCLE_POINT
            config   = $CYLC_SUITE_DEF_PATH/experiment.yaml

    # Tasks
    # -----
    [[CloneGeos]]
        script = "swell task CloneGeos $config"

    [[BuildGeosByLinking]]
        script = "swell task BuildGeosByLinking $config"

    [[BuildGeos]]
        script = "swell task BuildGeos $config"
        platform = {{platform}}
        execution time limit = {{scheduling["BuildGeos"]["execution_time_limit"]}}
        [[[directives]]]
        {%- for key, value in scheduling["BuildGeos"]["directives"]["all"].items() %}
            --{{key}} = {{value}}
        {%- endfor %}

    [[GetCoupledGeosRestart]]
        script = "swell task GetCoupledGeosRestart $config -d $datetime"

    [[PrepCoupledEnsembleGeosRunDir]]
        script = "swell task PrepCoupledEnsembleGeosRunDir $config -d $datetime"

    [[MoveEnsembleForecastRestarts]]
        script = "swell task MoveEnsembleForecastRestarts $config -d $datetime"

    {% for m in members %}
    [[RunGeosEns_{{"%03d" | format(m)}}]]
        script = "{{experiment_path}}/GEOSgcm/mem{{"%03d" | format(m)}}/gcm_run.j"
        platform = {{platform}}
        execution time limit = {{scheduling["RunGeosEns"]["execution_time_limit"]}}
        [[[directives]]]
        {%- for key, value in scheduling["RunGeosEns"]["directives"]["all"].items() %}
            --{{key}} = {{value}}
        {%- endfor %}
    {% endfor %}

# --------------------------------------------------------------------------------------------------
