# --------------------------------------------------------------------------------------------------

# Cylc suite for executing JEDI-based LocalEnsembleDA Algorithm

# --------------------------------------------------------------------------------------------------

[scheduler]
    UTC mode = True
    allow implicit tasks = False

{{scheduling['stall_timeout']}}

# --------------------------------------------------------------------------------------------------

[scheduling]

    initial cycle point = {{start_cycle_point}}
    final cycle point = {{final_cycle_point}}
    runahead limit = {{runahead_limit}}

    [[graph]]

        {% for cycle_time in cycle_times %}
        {{cycle_time.cycle_time}} = """
        {% for model_component in model_components %}
        {% if cycle_time[model_component] %}
            # Task triggers for: {{model_component}}
            # ------------------

            {% if model_component == 'geos_atmosphere' %}
                {% for i in range( 1, models[model_component]['ensemble_num_members'] + 1 ) %}
                    RunJediLocalEnsembleDaExecutable-{{model_component}}
                {% endfor %}
            {% elif model_component == 'geos_marine' %}
                {% for i in range( 1, models[model_component]['ensemble_num_members'] + 1 ) %}
                    CloneGmaoPerllib
                 {% endfor %}
            {% else %}
                CloneJedi
           {% endif %}

        {% endif %}
        {% endfor %}
        """
        {% endfor %}


# --------------------------------------------------------------------------------------------------

[runtime]

    # Task defaults
    # -------------
    [[root]]
        pre-script = "source $CYLC_SUITE_DEF_PATH/modules"

        [[[environment]]]
            datetime = $CYLC_TASK_CYCLE_POINT
            config   = $CYLC_SUITE_DEF_PATH/experiment.yaml

    # Tasks
    # -----


    {% for model_component in model_components %}
      {% if model_component == 'geos_atmosphere' %}

        {% if models[model_component]['ensemble_num_members'] is defined %}
          {% for i in range( 1, models[model_component]['ensemble_num_members'] + 1 ) %}
            [[RunJediLocalEnsembleDaExecutable-{{model_component}}]]
            script = "swell task RunJediLocalEnsembleDaExecutable $config -d $datetime -m {{model_component}}"
            platform = {{platform}}
            execution time limit = {{scheduling["RunJediLocalEnsembleDaExecutable"]["execution_time_limit"]}}
            [[[directives]]]
            {%- for key, value in scheduling["RunJediLocalEnsembleDaExecutable"]["directives"][model_component].items() %}
                --{{key}} = {{value}}
            {%- endfor %}
          {% endfor %}
        {% endif %}

      {% elif model_component == 'geos_marine'  %}

        {% if models[model_component]['ensemble_num_members'] is defined %}
          {% for i in range( 1, models[model_component]['ensemble_num_members'] + 1 ) %}
            [[CloneGmaoPerllib]]
              script = "swell task CloneGmaoPerllib $config -m {{model_component}}"
          {% endfor %}
        {% endif %}

      {% else %}

         [[CloneJedi]]
            script = "swell task CloneJedi $config"

      {% endif %}

    {% endfor %}

#    # Suite question can be used in flow.cylc to set tasks - gmao_perllib_tag shows up in experiment.yaml
#    {% if models['geos_marine']['ensemble_num_members'] is defined %}
#    [[CloneGmaoPerllib]]
#        script = "swell task CloneGmaoPerllib $config -m {{model_component}}"
#    {% endif %}

    [[sync_point]]
        script = true
# --------------------------------------------------------------------------------------------------
