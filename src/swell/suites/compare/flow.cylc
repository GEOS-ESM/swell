# --------------------------------------------------------------------------------------------------

# Cylc suite for running comparison tests on completed experiments



# --------------------------------------------------------------------------------------------------

[scheduler]
    UTC mode = True
    allow implicit tasks = False
    [[queues]]
        [[[default]]]
            limit = 10

# --------------------------------------------------------------------------------------------------

[scheduling]

    initial cycle point = {{start_cycle_point}}
    final cycle point = {{final_cycle_point}}
    runahead limit = {{runahead_limit}}

    [[graph]]
	R1 = """
        {% for model_component in model_components %}
            JediLogComparison-{{model_component}}?
        {% endfor %}     
        """
        {% for cycle_time in cycle_times %}
        {{cycle_time.cycle_time}} = """
        {% for model_component in model_components %}
        {% if cycle_time[model_component] %}
            {% for path in comparison_experiment_paths %}
            JediOopsLogParser-{{model_component}}-{{ loop.index0 }}
            {% endfor %}
            {% for observation in models[model_component]['observations'] %}
            CompareHofxObservations-{{model_component}}-{{observation}}:fail? => EvaComparisonObservations-{{model_component}}-{{observation}} => comparison_fail
            {% endfor %}
            JediLogComparison-{{model_component}}[^]:fail? => EvaComparisonIncrement-{{model_component}} => PublishComparisons => comparison_fail
            JediLogComparison-{{model_component}}[^]:fail? => EvaComparisonJediLog-{{model_component}} => PublishComparisons => comparison_fail
	    JediLogComparison-{{model_component}}[^]:fail? => PublishComparisons => comparison_fail
        {% endif %}
        {% endfor %}
        """
        {% endfor %}

# --------------------------------------------------------------------------------------------------

[runtime]

    # Task defaults
    # -------------

    [[root]]
        pre-script = """
            source $CYLC_SUITE_DEF_PATH/modules
        """

        [[[environment]]]
            datetime = $CYLC_TASK_CYCLE_POINT
            config = $CYLC_SUITE_DEF_PATH/experiment.yaml

    [[comparison_fail]]
        script = "exit 1"

    {% for model_component in model_components %}
    [[EvaComparisonIncrement-{{model_component}}]]
        script = "swell task EvaComparisonIncrement $config -d $datetime -m {{model_component}}"

    [[EvaComparisonJediLog-{{model_component}}]]
        script = "swell task EvaComparisonJediLog $config -d $datetime -m {{model_component}}"

    [[PublishComparisons]]
         script = "swell task PublishComparisons $config -d $datetime -m {{model_component}}"

    {% for observation in models[model_component]['observations'] %}
    [[CompareHofxObservations-{{model_component}}-{{observation}}]]
        script = "swell task CompareHofxObservations $config -d $datetime -m {{model_component}} -a {{observation}}"

    [[EvaComparisonObservations-{{model_component}}-{{observation}}]]
        script = "swell task EvaComparisonObservations $config -d $datetime -m {{model_component}} -a {{observation}}"
    {% endfor %}

    # swell task CompareHofxObservations $config -d $datetime -m {{model_component}}
    # swell task EvaComparisonObservations $config -d $datetime -m {{model_component}}

    {% if comparison_experiment_paths is mapping %}
    {% for path in comparison_experiment_paths.values() %}
    [[JediOopsLogParser-{{model_component}}-{{ loop.index0 }}]]
        script = "swell task JediOopsLogParser {{path}} -d $datetime -m {{model_component}}"
    {% endfor %}
    {% else %}
    {% for path in comparison_experiment_paths %}
    [[JediOopsLogParser-{{model_component}}-{{ loop.index0 }}]]
        script = "swell task JediOopsLogParser {{path}} -d $datetime -m {{model_component}}"
    {% endfor %}
    {% endif %}

    [[JediLogComparison-{{model_component}}]]
        script = "swell task JediLogComparison $config -m {{model_component}}"
    {% endfor %}

# --------------------------------------------------------------------------------------------------
